PORT=8080
DATABASE_URL=postgres://saksi:saksi@localhost:5432/saksi?sslmode=disable

# Wajib diisi — ambil dari dashboard AssemblyAI
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WS_URL=wss://streaming.assemblyai.com/v3/ws
# Bahasa Indonesia memerlukan Whisper Streaming. Nilai ini sengaja
# configurable karena daftar model streaming AssemblyAI masih berubah.
ASSEMBLYAI_SPEECH_MODEL=whisper-rt
# Minimum resmi 120000 ms; nilai lebih kecil otomatis dinaikkan server.
ASSEMBLYAI_SPEAKER_REVISION_INTERVAL_MS=120000
LLM_MODEL=claude-sonnet-4-6

# Jeda antar bisikan pengingat ke earpiece petugas (detik)
NUDGE_INTERVAL_SECONDS=45

ALLOWED_ORIGINS=http://localhost:5173
# Opsional: hasil build frontend untuk deployment satu-origin.
STATIC_DIR=
